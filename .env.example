# DART Open API (opendart.fss.or.kr)
DART_API_KEY=

# NAVER API HUB - 검색 API (developers.naver.com은 신규 신청 차단됨, ncloud.com 가입 필요)
# 가입 시 카드 등록 필수 -> Billing에서 예산 알림 낮게 설정해둘 것 (돈 쓰지 않기 위한 안전장치)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenAI API (platform.openai.com) - 에이전트/생성 LLM
# 가입 시 결제수단 등록 필요 -> Usage limits에서 예산 알림/월 한도 낮게 설정해둘 것
OPENAI_API_KEY=

# KRX 정보데이터시스템 (data.krx.co.kr) 로그인 - pykrx로 PER/PBR/시가총액 조회 시 필요
# (일별 주가 시세는 로그인 없이도 조회됨)
KRX_ID=
KRX_PW=
